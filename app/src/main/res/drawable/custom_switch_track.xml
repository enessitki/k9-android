<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Checked (Aktif) durum -->
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <corners android:radius="30dp"/>
            <solid android:color="@color/white"/> <!-- Yeşil -->
            <size android:height="30dp"/>
        </shape>
    </item>

    <!-- Unchecked (Pasif) durum -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="30dp"/>
            <gradient
                android:angle="270"
                android:startColor="@color/BLACK_A080"
                android:centerColor="@color/GRAY_050_A030"
                android:endColor="#11000000"
                android:centerY="0.2"
                android:type="linear"
                />
        </shape>
    </item>
</selector>