<?xml version="1.0" encoding="utf-8"?>
<!-- Durum ekrani: sirket standardi uc kart (ust ortada yuvarlak ikon rozeti,
     hap seklinde etiket/deger satirlari, renkli degerler). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:padding="10dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:orientation="horizontal">

        <!-- 1. BAGLANTI -->
        <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="12dp" android:layout_weight="1" android:clipChildren="false">
            <LinearLayout style="@style/StatCard" android:layout_width="match_parent">
                <LinearLayout style="@style/StatRow"><TextView style="@style/StatLabel" android:text="K9 bağlantısı" /><TextView android:id="@+id/st_k9_conn" style="@style/StatValue" android:text="-" /></LinearLayout>
                <LinearLayout style="@style/StatRow"><TextView style="@style/StatLabel" android:text="Video" /><TextView android:id="@+id/st_video_state" style="@style/StatValue" android:text="-" /></LinearLayout>
                <LinearLayout style="@style/StatRow"><TextView style="@style/StatLabel" android:text="Çözünürlük" /><TextView android:id="@+id/st_video" style="@style/StatValue" android:text="-" /></LinearLayout>
                <LinearLayout style="@style/StatRow"><TextView style="@style/StatLabel" android:text="Kare hızı" /><TextView android:id="@+id/st_fps" style="@style/StatValue" android:text="-" /></LinearLayout>
                <LinearLayout style="@style/StatRow"><TextView style="@style/StatLabel" android:text="Video kalitesi" /><TextView android:id="@+id/st_bitrate" style="@style/StatValue" android:text="-" /></LinearLayout>
                <View style="@style/StatDivider" />
                <LinearLayout style="@style/StatRow"><TextView style="@style/StatLabel" android:text="LED" /><TextView android:id="@+id/st_led" style="@style/StatValue" android:text="-" /></LinearLayout>
                <LinearLayout style="@style/StatRow"><TextView style="@style/StatLabel" android:text="Kör etme" /><TextView android:id="@+id/st_blind" style="@style/StatValue" android:text="-" /></LinearLayout>
                <LinearLayout style="@style/StatRow"><TextView style="@style/StatLabel" android:text="K9 hoparlör" /><TextView android:id="@+id/st_speaker" style="@style/StatValue" android:text="-" /></LinearLayout>
                <LinearLayout style="@style/StatRow"><TextView style="@style/StatLabel" android:text="Gürültü azaltma" /><TextView android:id="@+id/st_noise" style="@style/StatValue" android:text="-" /></LinearLayout>
            </LinearLayout>
            <ImageView style="@style/StatBadge" android:src="@drawable/wifi_strength_4" android:importantForAccessibility="no" />
        </FrameLayout>

        <!-- 2. K9 AYARLARI -->
        <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="12dp" android:layout_weight="1" android:clipChildren="false">
            <LinearLayout style="@style/StatCard" android:layout_width="match_parent">
                <LinearLayout style="@style/StatRow"><TextView style="@style/StatLabel" android:text="Ayar durumu" /><TextView android:id="@+id/st_config" style="@style/StatValue" android:text="-" /></LinearLayout>
                <View style="@style/StatDivider" />
                <LinearLayout android:id="@+id/st_k9_rows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
                <TextView android:id="@+id/st_k9_empty" style="@style/StatLabel" android:layout_width="match_parent" android:paddingHorizontal="10dp" android:paddingVertical="8dp" android:text="Sorgulanıyor…" />
            </LinearLayout>
            <ImageView style="@style/StatBadge" android:src="@drawable/baseline_settings_24" android:importantForAccessibility="no" />
        </FrameLayout>

        <!-- 3. KONTROL BIRIMI -->
        <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:clipChildren="false">
            <LinearLayout style="@style/StatCard" android:layout_width="match_parent">
                <LinearLayout style="@style/StatRow"><TextView style="@style/StatLabel" android:text="Pil" /><TextView android:id="@+id/st_battery" style="@style/StatValue" android:text="-" /></LinearLayout>
                <LinearLayout style="@style/StatRow"><TextView style="@style/StatLabel" android:text="Şarj" /><TextView android:id="@+id/st_charging" style="@style/StatValue" android:text="-" /></LinearLayout>
                <View style="@style/StatDivider" />
                <LinearLayout style="@style/StatRow"><TextView style="@style/StatLabel" android:text="GPS" /><TextView android:id="@+id/st_gps" style="@style/StatValue" android:text="-" /></LinearLayout>
                <LinearLayout style="@style/StatRow"><TextView style="@style/StatLabel" android:text="Konum" /><TextView android:id="@+id/st_gps_full" style="@style/StatValue" android:text="-" /></LinearLayout>
                <LinearLayout style="@style/StatRow"><TextView style="@style/StatLabel" android:text="MGRS" /><TextView android:id="@+id/st_mgrs" style="@style/StatValue" android:text="-" /></LinearLayout>
                <LinearLayout style="@style/StatRow"><TextView style="@style/StatLabel" android:text="Harita" /><TextView android:id="@+id/st_map" style="@style/StatValue" android:text="-" /></LinearLayout>
                <View style="@style/StatDivider" />
                <LinearLayout style="@style/StatRow"><TextView style="@style/StatLabel" android:text="Kiosk" /><TextView android:id="@+id/st_kiosk" style="@style/StatValue" android:text="-" /></LinearLayout>
                <LinearLayout style="@style/StatRow"><TextView style="@style/StatLabel" android:text="Depolama" /><TextView android:id="@+id/st_disk" style="@style/StatValue" android:text="-" /></LinearLayout>
                <LinearLayout style="@style/StatRow"><TextView style="@style/StatLabel" android:text="Sürüm" /><TextView android:id="@+id/st_version" style="@style/StatValue" android:text="-" /></LinearLayout>
                <LinearLayout style="@style/StatRow" android:layout_height="40dp"><TextView style="@style/StatLabel" android:text="Son güncelleme" /><TextView android:id="@+id/st_updated" style="@style/StatValue" android:layout_marginEnd="8dp" android:text="-" /><Button android:id="@+id/st_refresh" style="@style/StatBtn" android:text="YENİLE" /></LinearLayout>
            </LinearLayout>
            <ImageView style="@style/StatBadge" android:src="@drawable/ic_phone_24" android:importantForAccessibility="no" />
        </FrameLayout>
    </LinearLayout>
</ScrollView>
