<?xml version="1.0" encoding="utf-8"?>
<!-- Ana ekran: video altta, uzerinde ust serit, sol nav, sag fonksiyon cubugu,
     sayfalar (page_*) ve sag yan paneller (dialog_*). Eski projedeki
     main_after_login yapisinin karsiligi; mutlak dp yerine gravity ile
     konumlanir (5"/7" telefon). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:keepScreenOn="true">

    <SurfaceView
        android:id="@+id/video"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Sayfalar: sol ve sag cubuklarin arasinda, ust seridin altinda -->
    <FrameLayout
        android:id="@+id/page_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="64dp"
        android:layout_marginTop="44dp"
        android:layout_marginEnd="80dp"
        android:background="@color/page_bg"
        android:visibility="gone">
        <include android:id="@+id/page_record" layout="@layout/page_record" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" />
        <include android:id="@+id/page_status" layout="@layout/page_status" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" />
        <include android:id="@+id/page_settings" layout="@layout/page_settings" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" />
    </FrameLayout>

    <!-- Sag yan paneller: sag cubugun hemen solunda, tek seferde biri acik -->
    <FrameLayout
        android:id="@+id/panel_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|top"
        android:layout_marginTop="50dp"
        android:layout_marginEnd="84dp"
        android:translationZ="8dp">
        <include android:id="@+id/dialog_bitrate" layout="@layout/dialog_bitrate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" />
        <include android:id="@+id/dialog_led_blind" layout="@layout/dialog_led_blind" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" />
        <include android:id="@+id/dialog_speaker" layout="@layout/dialog_speaker" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" />
        <include android:id="@+id/dialog_record" layout="@layout/dialog_record" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" />
        <include android:id="@+id/dialog_map" layout="@layout/dialog_map" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" />
    </FrameLayout>

    <include
        android:id="@+id/top_layout"
        layout="@layout/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="64dp"
        android:layout_marginEnd="80dp" />

    <include
        android:id="@+id/left_layout"
        layout="@layout/left_bar"
        android:layout_width="64dp"
        android:layout_height="match_parent"
        android:layout_gravity="start" />

    <include
        android:id="@+id/right_layout"
        layout="@layout/right_bar"
        android:layout_width="80dp"
        android:layout_height="match_parent"
        android:layout_gravity="end" />

    <TextView
        android:id="@+id/txt_msg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="10dp"
        android:background="@drawable/card_background_dark"
        android:fontFamily="monospace"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:translationZ="20dp"
        android:visibility="gone" />
</FrameLayout>
