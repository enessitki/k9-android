<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="280dp"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/card_background_no_stroke"
        android:orientation="vertical"
        android:padding="12dp">
        <TextView style="@style/SectionTitle" android:text="VİDEO KALİTESİ" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:orientation="horizontal">
            <Button android:id="@+id/br1" style="@style/BtnToggle" android:text="DÜŞÜK" />
            <Button android:id="@+id/br2" style="@style/BtnToggle" android:text="ORTA" />
            <Button android:id="@+id/br3" style="@style/BtnToggle" android:text="YÜKSEK" />
            <Button android:id="@+id/br4" style="@style/BtnToggle" android:layout_marginEnd="0dp" android:text="EN YÜKSEK" />
        </LinearLayout>
        <TextView android:id="@+id/bitrate_hint" style="@style/RowValue" android:layout_marginTop="8dp" android:paddingHorizontal="10dp" android:text="Bağlantı zayıfsa düşük kalite seçin" android:textColor="@color/text_dim" android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
