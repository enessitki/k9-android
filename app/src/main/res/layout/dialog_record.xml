<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="280dp"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/card_background_no_stroke"
        android:orientation="vertical"
        android:padding="12dp">
        <TextView style="@style/SectionTitle" android:text="KAYIT" />
        <LinearLayout style="@style/RowAlt">
            <TextView style="@style/RowLabel" android:text="Ekran kaydı" />
            <Switch android:id="@+id/screen_record_switch" style="@style/SwitchK9" />
        </LinearLayout>
        <TextView android:id="@+id/record_state" style="@style/RowValue" android:paddingHorizontal="10dp" android:paddingTop="6dp" android:text="Kayıt yok" android:textColor="@color/text_dim" android:textSize="12sp" />
        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="8dp" android:background="@color/divider" />
        <Button android:id="@+id/screenshot_button" style="@style/BtnPrimary" android:layout_width="match_parent" android:layout_marginEnd="0dp" android:text="EKRAN GÖRÜNTÜSÜ AL" />
    </LinearLayout>
</FrameLayout>
