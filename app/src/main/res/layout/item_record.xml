<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="10dp">
    <ImageView android:id="@+id/item_icon" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_play_24" android:importantForAccessibility="no" />
    <TextView android:id="@+id/item_name" style="@style/RowValue" android:layout_width="0dp" android:layout_marginStart="10dp" android:layout_weight="1" android:singleLine="true" android:text="" android:textSize="13sp" />
    <TextView android:id="@+id/item_meta" style="@style/RowValue" android:text="" android:textColor="@color/text_dim" android:textSize="11sp" />
</LinearLayout>
