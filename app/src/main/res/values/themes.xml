<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.K9" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:windowFullscreen">true</item>
        <item name="colorPrimary">@color/accent_cyan</item>
        <item name="colorSecondary">@color/accent_cyan</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- Sol nav ikonu -->
    <style name="NavIcon">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:backgroundTint">@color/white</item>
    </style>
    <style name="NavLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textColor">@color/nav_label_idle</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.05</item>
    </style>
    <!-- Sag fonksiyon satiri (iki sutunda ayni yukseklik) -->
    <style name="FnRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
    </style>
    <!-- Sag fonksiyon ana ikonu -->
    <style name="FnIcon">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:backgroundTint">@color/white</item>
    </style>
    <!-- Expand (panel ac/kapa): video uzerinde, cubuga bitisik kucuk koyu kutu -->
    <style name="ExpandBtn">
        <item name="android:layout_width">30dp</item>
        <item name="android:layout_height">30dp</item>
        <item name="android:layout_gravity">end|center_vertical</item>
        <item name="android:foreground">@drawable/baseline_menu_open_24</item>
        <item name="android:background">@drawable/bg_expand</item>
    </style>
    <!-- Metin girisi: yuvarlatilmis koyu kutu -->
    <style name="Input">
        <item name="android:layout_width">140dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:paddingHorizontal">10dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textColorHint">@color/text_dim</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:singleLine">true</item>
        <item name="android:gravity">center_vertical|end</item>
    </style>
    <!-- Durum sayfasi KPI karti -->
    <style name="Tile">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@drawable/card_background_dark</item>
        <item name="android:orientation">horizontal</item>
    </style>
    <style name="TileAccent">
        <item name="android:layout_width">3dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@color/nav_label_idle</item>
    </style>
    <style name="TileBody">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">10dp</item>
    </style>
    <style name="TileTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.12</item>
    </style>
    <style name="TileValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="TileSub">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textColor">@color/nav_label_idle</item>
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">monospace</item>
    </style>
    <!-- Durum ekrani kartlari (sirket standardi: ust ortada yuvarlak ikon, hap satirlar) -->
    <style name="StatCard">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginTop">22dp</item>
        <item name="android:background">@drawable/bg_stat_card</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingTop">26dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:paddingHorizontal">10dp</item>
    </style>
    <style name="StatBadge">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_gravity">top|center_horizontal</item>
        <item name="android:background">@drawable/bg_stat_badge</item>
        <item name="android:padding">10dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:translationZ">2dp</item>
    </style>
    <style name="StatRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">30dp</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:background">@drawable/bg_stat_row</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingHorizontal">10dp</item>
    </style>
    <style name="StatLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">#D6D6D6</item>
        <item name="android:textSize">12sp</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
    </style>
    <style name="StatValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/nav_label_idle</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:singleLine">true</item>
    </style>
    <style name="StatDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginVertical">8dp</item>
        <item name="android:background">#2A2A2A</item>
    </style>
    <style name="StatBtn">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">26dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:background">@drawable/bg_stat_btn</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <!-- Kart baslik satiri -->
    <style name="CardHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>
    <style name="CardHeaderMark">
        <item name="android:layout_width">3dp</item>
        <item name="android:layout_height">14dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@color/accent_cyan</item>
    </style>
    <style name="CardHeaderText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.05</item>
    </style>
    <!-- Yan panel kart satirlari -->
    <style name="Row">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingHorizontal">10dp</item>
    </style>
    <style name="RowAlt" parent="Row">
        <item name="android:background">@drawable/row_background_alt</item>
    </style>
    <style name="RowLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">#E6E6E6</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="RowValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">monospace</item>
    </style>
    <style name="RowEdit">
        <item name="android:layout_width">120dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:singleLine">true</item>
        <item name="android:gravity">end</item>
        <item name="android:backgroundTint">@color/accent_cyan</item>
    </style>
    <style name="SwitchK9">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:switchMinWidth">60dp</item>
        <item name="android:thumb">@drawable/custom_switch_thump</item>
        <item name="android:track">@drawable/custom_switch_track</item>
        <item name="android:background">@drawable/switch_ripple</item>
    </style>
    <style name="SectionTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/ok</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:paddingHorizontal">10dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>
    <style name="BtnPrimary">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">@drawable/bg_btn_primary</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:layout_marginEnd">8dp</item>
    </style>
    <style name="BtnGhost" parent="BtnPrimary">
        <item name="android:background">@drawable/bg_btn_ghost</item>
        <item name="android:textColor">@color/white</item>
    </style>
    <style name="BtnToggle" parent="BtnGhost">
        <item name="android:background">@drawable/bg_btn_toggle</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:paddingHorizontal">4dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:singleLine">true</item>
    </style>
    <style name="Chip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:clipToOutline">true</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:background">@drawable/bg_comm_chip</item>
        <item name="android:layout_marginEnd">8dp</item>
    </style>
    <style name="ChipCap">
        <item name="android:layout_width">34dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_chip_cap</item>
    </style>
    <style name="ChipText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:includeFontPadding">false</item>
    </style>
</resources>
